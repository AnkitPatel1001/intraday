# Indian Stock Market Intelligence Platform - Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env.

# --- Application ---
# APP_ENV=production disables /docs, /redoc, /openapi.json
APP_ENV=development
# Never enable in production
APP_DEBUG=false
# Optional: fixed session-signing secret. Random per process when unset.
APP_SECRET_KEY=change-me-to-a-long-random-string

# --- Data Provider ---
# Options: demo, yahoo, upstox
# "demo" = synthetic data, clearly labeled, no network calls
DATA_PROVIDER=demo

# Yahoo Finance (free, unofficial, can lag — use only for research/demo)
YAHOO_ENABLED=true

# --- Upstox (DATA_PROVIDER=upstox) ---
# Free official market-data API. PAPER ONLY here: this app never places orders.
# Sandbox-first (default): mode is reported in provider health as "sandbox".
# Upstox sandbox (api-sandbox.upstox.com) hosts ORDER APIs only — market data
# lives on api.upstox.com and is read-only (no account/order access possible).
UPSTOX_SANDBOX=true
# Get credentials: see README "Upstox (free official data, WebSocket quotes)".
# Prefer the long-lived Analytics Token (no daily re-auth) for market data.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=
UPSTOX_ANALYTICS_TOKEN=
# WebSocket quote feed (avoids REST polling / 429s). Set false for REST-only.
UPSTOX_WS_ENABLED=true
# Client-side REST throttle; Upstox allows 50 req/s for quotes/OHLC.
UPSTOX_REST_MAX_PER_SECOND=10
# Where the symbol->instrument-key cache is stored (auto-refreshed every 7 days)
UPSTOX_INSTRUMENT_CACHE=data/upstox_nse_instruments.json

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# JSON list of allowed browser origins
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Market Intel
NEXT_PUBLIC_DATA_MODE=demo

# --- Risk Defaults (INR) ---
DEFAULT_CAPITAL=500000
DEFAULT_RISK_PER_TRADE_PCT=1.0
DEFAULT_MAX_DAILY_LOSS_PCT=3.0
DEFAULT_MAX_POSITIONS=5
DEFAULT_MIN_RISK_REWARD=1.5

# --- Security ---
# Session auth gates all non-public API routes (paper/trades/backtest/risk/analytics).
# Clients obtain a token via POST /api/v1/auth/session.
AUTH_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
SESSION_TIMEOUT_HOURS=24

# --- Paper Trading ---
# Allow simulated orders outside NSE session hours (09:15-15:30 IST).
# Default false: orders rejected with 400 while market closed. Set true only
# for tests/demos that must place orders on weekends.
PAPER_ALLOW_OFF_HOURS=false
